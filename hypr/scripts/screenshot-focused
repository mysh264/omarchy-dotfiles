#!/bin/bash
# Screenshot the focused Hyprland window (save + clipboard + notify).

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"
mkdir -p "$OUTPUT_DIR"

geo=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
if [[ ! $geo =~ ^-?[0-9]+,-?[0-9]+[[:space:]][0-9]+x[0-9]+$ ]]; then
  exit 1
fi

filepath="$OUTPUT_DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
grim -g "$geo" "$filepath" || exit 1
wl-copy --type image/png <"$filepath"
omarchy-notification-send "Screenshot saved to clipboard and file" "Focused window" \
  --image "$filepath" || true
echo "$filepath"
